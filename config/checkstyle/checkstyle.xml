<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
    Quy tac Checkstyle cua project (BANK-008), xem muc 20 docs/convention-code.md.
    Format va thu tu import do Spotless lo, file nay chi chua quy tac Spotless khong kiem duoc.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="charset" value="UTF-8"/>
    <property name="fileExtensions" value="java"/>

    <!-- Muc 15: class nen <= 300 dong -->
    <module name="FileLength">
        <property name="max" value="300"/>
    </module>

    <module name="TreeWalker">
        <!-- Muc 15: khong wildcard import -->
        <module name="AvoidStarImport"/>

        <!-- Muc 13: dung SLF4J, khong in ra console -->
        <module name="RegexpSinglelineJava">
            <property name="id" value="noSystemOutErr"/>
            <property name="format" value="System\.(out|err)\b"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Khong dung System.out/System.err, dung SLF4J (@Slf4j)."/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="id" value="noPrintStackTrace"/>
            <property name="format" value="printStackTrace\("/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Khong goi printStackTrace(), log exception bang SLF4J."/>
        </module>

        <!-- Muc 5: chi constructor injection -->
        <module name="MatchXpath">
            <property name="id" value="noFieldInjection"/>
            <property name="query" value="//VARIABLE_DEF[./MODIFIERS/ANNOTATION/IDENT[@text='Autowired']]"/>
            <message key="matchxpath.match"
                     value="Khong dung @Autowired tren field, dung constructor injection (private final + @RequiredArgsConstructor)."/>
        </module>

        <!-- Muc 15: method nen <= 30 dong -->
        <module name="MethodLength">
            <property name="max" value="30"/>
            <property name="countEmpty" value="false"/>
        </module>
    </module>
</module>
