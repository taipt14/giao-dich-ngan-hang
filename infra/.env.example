# Copy file nay thanh infra/.env roi doi gia tri. infra/.env da nam trong .gitignore, khong commit.
# Mat khau Oracle: chi dung chu cai va chu so (ky tu / @ " lam hong chuoi ket noi va script init).

# Mat khau SYS / SYSTEM cua Oracle
ORACLE_PASSWORD=ChangeMe_Sys1

# Mat khau user/schema cua tung service (doc boi infra/oracle/init/01_create_service_schemas.sh)
CUSTOMER_SVC_DB_PASSWORD=ChangeMe_Customer1
ACCOUNT_SVC_DB_PASSWORD=ChangeMe_Account1
TRANSFER_SVC_DB_PASSWORD=ChangeMe_Transfer1
NAPAS_SVC_DB_PASSWORD=ChangeMe_Napas1
NOTI_SVC_DB_PASSWORD=ChangeMe_Noti1
FRAUD_SVC_DB_PASSWORD=ChangeMe_Fraud1

# Cluster id cua Kafka KRaft (base64 UUID 22 ky tu). Tao moi: docker run --rm apache/kafka:3.9.1 /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# Keycloak (chi dung local). Tai khoan admin console http://localhost:8180
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe_KcAdmin1
# Mat khau user mau cua realm bank (thay vao placeholder trong infra/keycloak/realm-bank.json khi import)
KEYCLOAK_CUSTOMER01_PASSWORD=ChangeMe_Customer01
KEYCLOAK_ADMIN01_PASSWORD=ChangeMe_Admin01
